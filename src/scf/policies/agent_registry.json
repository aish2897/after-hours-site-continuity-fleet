{
  "registry_version": "1.1.0",
  "description": "Runtime registry and governed catalog. Loaded at startup; gates both tool dispatch and which specialists the orchestrator may route to. The in-process check is defence in depth \u2014 the authoritative boundary is Google IAM at the Cloud Run service level. `llm_backed` describes what the runtime actually does today, not what the contract permits. `deployed` says whether a runtime exists; `enabled` is the lifecycle switch that withdraws an agent from service without a redeploy. Governance here controls DISCOVERY only and can never authorize an infrastructure change.",
  "agents": {
    "orchestrator": {
      "version": "1.0.0",
      "llm_backed": true,
      "service_account": "sa-orchestrator",
      "may_propose_actions": false,
      "may_write_firestore": true,
      "allowed_tools": [
        "create_incident",
        "route_specialists",
        "request_policy_decision",
        "request_execution"
      ],
      "deployed": true,
      "enabled": true
    },

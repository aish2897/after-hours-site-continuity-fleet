{
  "policy_version": "1.1.0",
  "description": "Deterministic authorization policy. This file is the single source of truth. If a rule is not here, it is not a rule. Evaluated only against TRUSTED_TOOL evidence.",
  "targets": {
    "dispatch-web": {
      "target_type": "cloud_run_service_non_critical",
      "region": "australia-southeast1"
    },
    "site-directory": {
      "target_type": "cloud_run_service_non_critical",
      "region": "australia-southeast1"
    },
    "dispatch-db": {
      "target_type": "production_database",
      "region": "australia-southeast1"
    },
    "site-firewall": {
      "target_type": "network_control",
      "region": "australia-southeast1"
    },
    "credential-store": {
      "target_type": "secret_store",
      "region": "australia-southeast1"
    }
  },
  "rules": [
    {
      "action_type": "FLIP_TRAFFIC_TO_LAST_GOOD",
      "target_type": "cloud_run_service_non_critical",
      "decision": "AUTO_ALLOWED",
      "reason_code": "LOW_RISK_TRAFFIC_FLIP",
      "reason": "Shifting traffic to an operator-approved revision that was independently probed healthy is reversible and does not alter data.",
      "required_evidence": {
        "service_unhealthy": true,
        "candidate_revision_approved": true,
        "candidate_probe_healthy": true
      }
    },
    {
      "action_type": "RESTART_APPLICATION_SERVICE",
      "target_type": "cloud_run_service_non_critical",
      "decision": "AUTO_ALLOWED",
      "reason_code": "LOW_RISK_RESTART",
      "reason": "Restarting a stopped non-critical application service is low risk once reachability is confirmed.",
      "required_evidence": {
        "service_unhealthy": true,
        "server_reachable": true
      }
    },
    {
      "action_type": "RESTART_DATABASE_SERVICE",
      "target_type": "production_database",
      "decision": "APPROVAL_REQUIRED",
      "reason_code": "PRODUCTION_DATA_RISK",
      "reason": "Production database restart can interrupt transactions and cause data loss.",
      "required_approval_role": "incident_commander"
    },
    {
      "action_type": "DISABLE_FIREWALL",
      "target_type": "*",
      "decision": "DENIED",
      "reason_code": "NEVER_AUTONOMOUS",
      "reason": "Disabling network controls is outside autonomous authority under any evidence."
    },
    {
      "action_type": "EXPORT_CREDENTIALS",
      "target_type": "*",
      "decision": "DENIED",
      "reason_code": "NEVER_ALLOWED",
      "reason": "Credential export is never permitted, by any actor, under any evidence."
    }
  ],
  "default": {
    "decision": "DENIED",
    "reason_code": "NO_MATCHING_RULE",
    "reason": "No policy rule authorizes this action against this target type."
  }
}
